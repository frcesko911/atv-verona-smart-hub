# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Server
PORT=3001
NODE_ENV=development

# JWT Secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# JWT expiry
JWT_EXPIRES_IN=24h

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database path
DB_PATH=./data/atv.db

# Admin panel password (protects /admin and /api/admin/*)
# If unset, the admin panel is disabled.
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# GTFS feed URLs (official ATV open data — direct .zip links).
# When set, the server imports them on boot and weekly; when unset it
# serves the bundled bus dataset. Run a one-off import with: npm run import-gtfs
GTFS_URL_URBANO=
GTFS_URL_EXTRAURBANO=
